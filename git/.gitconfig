[user]
	name = Oli Gustafsson
	email = oli@personligalmanacka.se
[core]
	autocrlf = input
[safe]
	directory = /Applications/XAMPP/xamppfiles/htdocs/pa_pop
[http]
	postBuffer = 524288000
[i18n]
	logOutputEncoding = utf-8
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
